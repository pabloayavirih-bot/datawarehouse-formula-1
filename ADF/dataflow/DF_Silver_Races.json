{
	"name": "DF_Silver_Races",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Races_SQL",
						"type": "DatasetReference"
					},
					"name": "OrigenRaces"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Races_SQL",
						"type": "DatasetReference"
					},
					"name": "DestinoRaces"
				}
			],
			"transformations": [
				{
					"name": "LimpiezaRaces"
				},
				{
					"name": "NormalizacionFechasRaces"
				}
			],
			"scriptLines": [
				"source(output(",
				"          raceId as string,",
				"          year as string,",
				"          round as string,",
				"          circuitId as string,",
				"          name as string,",
				"          date as string,",
				"          time as string,",
				"          url as string,",
				"          fp1_date as string,",
				"          fp1_time as string,",
				"          fp2_date as string,",
				"          fp2_time as string,",
				"          fp3_date as string,",
				"          fp3_time as string,",
				"          quali_date as string,",
				"          quali_time as string,",
				"          sprint_date as string,",
				"          sprint_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenRaces",
				"OrigenRaces derive(raceId = toInteger(trim(raceId)),",
				"          year = toInteger(trim(year)),",
				"          round = toInteger(trim(round)),",
				"          circuitId = toInteger(trim(circuitId)),",
				"          name = iif(trim(name) == lower(trim(name)) || trim(name) == upper(trim(name)), initCap(regexReplace(trim(name), ' +', ' ')), regexReplace(trim(name), ' +', ' ')),",
				"          time = iif(regexMatch(trim(time), `^(?:\\\\N)?$`), toString(null()), trim(time)),",
				"          url = iif(regexMatch(trim(url), `^(?:\\\\N)?$`), toString(null()), trim(url)),",
				"          fp1_date = iif(regexMatch(trim(fp1_date), `^(?:\\\\N)?$`), toString(null()), trim(fp1_date)),",
				"          fp1_time = iif(regexMatch(trim(fp1_time), `^(?:\\\\N)?$`), toString(null()), trim(fp1_time)),",
				"          fp2_date = iif(regexMatch(trim(fp2_date), `^(?:\\\\N)?$`), toString(null()), trim(fp2_date)),",
				"          fp2_time = iif(regexMatch(trim(fp2_time), `^(?:\\\\N)?$`), toString(null()), trim(fp2_time)),",
				"          fp3_date = iif(regexMatch(trim(fp3_date), `^(?:\\\\N)?$`), toString(null()), trim(fp3_date)),",
				"          fp3_time = iif(regexMatch(trim(fp3_time), `^(?:\\\\N)?$`), toString(null()), trim(fp3_time)),",
				"          quali_date = iif(regexMatch(trim(quali_date), `^(?:\\\\N)?$`), toString(null()), trim(quali_date)),",
				"          quali_time = iif(regexMatch(trim(quali_time), `^(?:\\\\N)?$`), toString(null()), trim(quali_time)),",
				"          sprint_date = iif(regexMatch(trim(sprint_date), `^(?:\\\\N)?$`), toString(null()), trim(sprint_date)),",
				"          sprint_time = iif(regexMatch(trim(sprint_time), `^(?:\\\\N)?$`), toString(null()), trim(sprint_time))) ~> LimpiezaRaces",
				"LimpiezaRaces derive(date =  case(     regexMatch(trim(date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),     toDate(trim(date), 'yyyy-MM-dd'),      regexMatch(trim(date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),     toDate(trim(date), 'dd/MM/yyyy'),      regexMatch(trim(date), '^[0-9]{4}/[0-9]{2}/[0-9]{2}$'),     toDate(trim(date), 'yyyy/MM/dd'),      regexMatch(trim(date), '^[0-9]{2}-[0-9]{2}-[0-9]{4}$'),     toDate(trim(date), 'MM-dd-yyyy'),      regexMatch(trim(date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),     toDate(trim(date), 'dd-MMM-yyyy'),      toDate(null()) )) ~> NormalizacionFechasRaces",
				"NormalizacionFechasRaces sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          raceId as integer,",
				"          year as integer,",
				"          round as integer,",
				"          circuitId as integer,",
				"          name as string,",
				"          date as date,",
				"          time as string,",
				"          url as string,",
				"          fp1_date as string,",
				"          fp1_time as string,",
				"          fp2_date as string,",
				"          fp2_time as string,",
				"          fp3_date as string,",
				"          fp3_time as string,",
				"          quali_date as string,",
				"          quali_time as string,",
				"          sprint_date as string,",
				"          sprint_time as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          raceId,",
				"          year,",
				"          round,",
				"          circuitId,",
				"          name,",
				"          date,",
				"          time,",
				"          url,",
				"          fp1_date,",
				"          fp1_time,",
				"          fp2_date,",
				"          fp2_time,",
				"          fp3_date,",
				"          fp3_time,",
				"          quali_date,",
				"          quali_time,",
				"          sprint_date,",
				"          sprint_time",
				"     )) ~> DestinoRaces"
			]
		}
	}
}