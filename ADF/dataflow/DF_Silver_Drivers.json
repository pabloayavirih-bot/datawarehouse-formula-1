{
	"name": "DF_Silver_Drivers",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Drivers_SQL",
						"type": "DatasetReference"
					},
					"name": "OrigenDrivers"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Drivers_SQL",
						"type": "DatasetReference"
					},
					"name": "DestinoDrivers"
				}
			],
			"transformations": [
				{
					"name": "LimpiezaDrivers"
				},
				{
					"name": "NormalizacionFechasDrivers"
				},
				{
					"name": "DeduplicacionDrivers"
				}
			],
			"scriptLines": [
				"source(output(",
				"          driverId as string,",
				"          driverRef as string,",
				"          number as string,",
				"          code as string,",
				"          forename as string,",
				"          surname as string,",
				"          dob as string,",
				"          nationality as string,",
				"          url as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenDrivers",
				"OrigenDrivers derive(driverId = toInteger(trim(driverId)),",
				"          driverRef = lower(trim(driverRef)),",
				"          number = toInteger(trim(number)),",
				"          code = iif(length(trim(code)) == 3, upper(trim(code)), toString(null())),",
				"          forename = iif(trim(forename) == lower(trim(forename)) || trim(forename) == upper(trim(forename)), initCap(regexReplace(trim(forename), ' +', ' ')), regexReplace(trim(forename), ' +', ' ')),",
				"          surname = iif(trim(surname) == lower(trim(surname)) || trim(surname) == upper(trim(surname)), initCap(regexReplace(trim(surname), ' +', ' ')), regexReplace(trim(surname), ' +', ' ')),",
				"          nationality = iif(isNull(nationality) || regexMatch(trim(nationality), `^(?:\\\\N)?$`), 'Unknown', regexReplace(trim(nationality), ' +', ' ')),",
				"          url = iif(regexMatch(trim(url), `^(?:\\\\N)?$`), toString(null()), trim(url))) ~> LimpiezaDrivers",
				"LimpiezaDrivers derive(dob =  case(     regexMatch(trim(dob), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),     toDate(trim(dob), 'yyyy-MM-dd'),      regexMatch(trim(dob), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'),     toDate(trim(dob), 'dd/MM/yyyy'),      regexMatch(trim(dob), '^[0-9]{4}/[0-9]{2}/[0-9]{2}$'),     toDate(trim(dob), 'yyyy/MM/dd'),      regexMatch(trim(dob), '^[0-9]{2}-[0-9]{2}-[0-9]{4}$'),     toDate(trim(dob), 'MM-dd-yyyy'),      regexMatch(trim(dob), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'),     toDate(trim(dob), 'dd-MMM-yyyy'),      toDate(null()) )) ~> NormalizacionFechasDrivers",
				"NormalizacionFechasDrivers aggregate(groupBy(driverId),",
				"     driverRef = first(driverRef),",
				"          number = first(number),",
				"          code = first(code),",
				"          forename = first(forename),",
				"          surname = first(surname),",
				"          dob = first(dob),",
				"          nationality = first(nationality),",
				"          url = first(url)) ~> DeduplicacionDrivers",
				"DeduplicacionDrivers sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          driverId as integer,",
				"          driverRef as string,",
				"          number as integer,",
				"          code as string,",
				"          forename as string,",
				"          surname as string,",
				"          dob as date,",
				"          nationality as string,",
				"          url as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          driverId,",
				"          driverRef,",
				"          number,",
				"          code,",
				"          forename,",
				"          surname,",
				"          dob,",
				"          nationality,",
				"          url",
				"     )) ~> DestinoDrivers"
			]
		}
	}
}